# Скопируйте этот файл в .env и замените пример своим ключом.
OPENAI_API_KEY=your_api_key_here
BUSINESS_BACKUP_PASSPHRASE=
# Опциональная почта: чтение read-only, отправка только после подтверждения.
BUSINESS_EMAIL_ENABLED=false
BUSINESS_EMAIL_IMAP_HOST=imap.gmail.com
BUSINESS_EMAIL_IMAP_PORT=993
BUSINESS_EMAIL_SMTP_HOST=smtp.gmail.com
BUSINESS_EMAIL_SMTP_PORT=465
BUSINESS_EMAIL_USERNAME=
BUSINESS_EMAIL_APP_PASSWORD=
BUSINESS_EMAIL_MAILBOX=INBOX
BUSINESS_EMAIL_MAX_MESSAGES=30
BUSINESS_EMAIL_TIMEOUT=30
MCP_ENABLED=false
# Отключает справочные сетевые инструменты также при MCP_ENABLED=false.
MCP_ALLOW_PUBLIC_NETWORK=false
# Необязательно: имена через запятую; пусто = все доступные инструменты MCP.
MCP_TOOL_NAMES=
